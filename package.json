{
	"name": "port_folio_nm_ts",
	"version": "1.0.0",
	"description": "ローカルDBに接続してデータを取得・表示するTypeScriptアプリケーション",
	"main": "dist/src/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node dist/src/index.js",
		"dev": "ts-node src/index.ts",
		"dev:watch": "ts-node --watch src/index.ts",
		"db-info": "ts-node src/db-info.ts",
		"migrate": "ts-node src/migration.ts",
		"migrate:rollback": "ts-node src/migration.ts --rollback",
		"test:new-table": "ts-node src/test-new-table.ts",
		"clean": "rimraf dist",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [
		"typescript",
		"postgresql",
		"database",
		"nodejs"
	],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@types/node": "^22.13.13",
		"@types/pg": "^8.11.11",
		"rimraf": "^5.0.10",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"dotenv": "^16.4.7",
		"pg": "^8.14.1",
		"pg-promise": "^11.13.0"
	}
}
